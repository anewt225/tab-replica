# Postgres. Local dev: `docker compose up -d` then use the URL below as-is.
# Production: your Neon / Vercel Postgres connection string.
DATABASE_URL=postgres://tab:tab@localhost:5433/tab

# Claude API key — used for receipt OCR + itemization.
# Roughly $0.01-0.03 per receipt with claude-opus-5.
ANTHROPIC_API_KEY=

# Signs the device-identity cookie. Any long random string.
# Generate one with: openssl rand -hex 32
DEVICE_COOKIE_SECRET=

# Vercel Blob token. Leave empty in local dev — uploads fall back to
# writing into ./uploads and serving from /api/uploads/[name].
BLOB_READ_WRITE_TOKEN=
