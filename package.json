{
  "name": "tab-replica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "ocr:check": "tsx --env-file-if-exists=.env scripts/ocr-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@vercel/blob": "^2.6.1",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^5.1.6",
    "next": "^16.2.12",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "fast-check": "^4.4.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
